# ============================================================
#  知药 · 智能服药提醒系统  配置模板
# ------------------------------------------------------------
#  使用方法：
#     Windows        copy .env.example .env
#     macOS / Linux  cp .env.example .env
#  然后把下面的空值填上。
#
#  注意：真正的 .env 已被 .gitignore 排除，不会被提交到仓库。
# ============================================================

# ---- 讯飞开放平台凭证（必填）----
# 申请地址：https://console.xfyun.cn/
# 需要开通三个服务：语音听写(IAT)、语音合成(TTS)、通用文字识别(OCR)
# 星火大模型用的是 same 的 APP_ID，控制台里开通「星火认知大模型」即可
APP_ID=
API_KEY=
API_SECRET=

# ---- MySQL 数据库（必填）----
# 建库建账号的命令见 docs/DATABASE.md 第三节，
# 也可以填好本文件后执行：python setup_env.py --create-db --admin-user root --admin-password 你的root密码
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dev_app
DB_PASSWORD=
DB_NAME=pill_reminder
# 1 = 把执行的 SQL 打印到控制台（调试用）
DB_ECHO=0
